<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>HemStore</RootNamespace>
		<UserSecretsId>hemstore-7c1d4e2a9b30</UserSecretsId>
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
	</ItemGroup>

	<!-- The database script is built into the app; it runs at start-up (see Services/DbMigrator.cs). -->
	<ItemGroup>
		<EmbeddedResource Include="Database\HemStore_Create.sql" LogicalName="HemStore.Database.HemStore_Create.sql" />
	</ItemGroup>

	<!-- Uploaded files live outside wwwroot and are never published from a developer machine. -->
	<ItemGroup>
		<Content Remove="App_Data\**" />
		<None Remove="App_Data\**" />
	</ItemGroup>

</Project>
